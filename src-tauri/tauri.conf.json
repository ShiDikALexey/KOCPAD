{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KOCPAD",
  "version": "1.4.1",
  "identifier": "app.kocpad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KOCPAD",
        "width": 1240,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#13161a"
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2Q0QxQjE0RDRBM0Y3NzQKUldSMDk2UFVGQnZOVmtER1FMdmJzYXBqeUVXVVhZeWR3YnkwTWZ0SUlTeVRZNXJDbGQxdERhNkQK",
      "endpoints": [
        "https://github.com/ShiDikALexey/KOCPAD/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
